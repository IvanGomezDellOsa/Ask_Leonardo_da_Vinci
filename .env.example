# Gemini — Proyecto A, sin facturación habilitada (free tier intacto)
GEMINI_API_KEY_A=

# Gemini — Proyecto B, con facturación habilitada (desactivado por defecto)
GEMINI_API_KEY_B=

# Groq — fallback/overflow, free tier independiente
GROQ_API_KEY=

# Upstash Redis — rate limit y contador global (src/lib/limites.ts).
# Sin esto el limitador cuenta EN MEMORIA: exacto dentro de una instancia,
# ciego entre instancias. Funciona, pero en serverless el límite efectivo se
# multiplica por la cantidad de instancias. Ver D-123, D-218 y docs/22-publicar.md.
#
# ⚠ SE ACEPTAN DOS JUEGOS DE NOMBRES, porque no los elegimos nosotros (D-219):
# copiando las claves a mano desde Upstash llegan como `UPSTASH_REDIS_REST_*`,
# pero agregando la base desde el Marketplace de Vercel las inyecta él con SUS
# nombres, `KV_REST_API_URL` / `KV_REST_API_TOKEN`. Los dos sirven; si están los
# dos, gana el de Upstash. Van los DOS de un juego: media credencial no cuenta.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sal para hashear la IP en el rate limiter (D-034, R19). La IP cruda NUNCA se
# guarda. Sin esta variable se genera una sal efímera por instancia: más privado
# pero el límite diario por IP se reinicia con el proceso. En producción, fijarla.
#   openssl rand -hex 32
SAL_IP=

# Cloudflare Turnstile — anti-bot. VAN LAS DOS O NINGUNA (D-206).
#
# ⚠ Poner sólo la secreta devuelve 403 a TODO EL MUNDO: el servidor exige un
# token que el cliente no puede emitir sin la site key. Con las dos, el widget
# se monta invisible y sólo aparece si Cloudflare decide desafiar; sin ninguna,
# la verificación no bloquea nada y los otros tres límites siguen en pie.
#
# La site key es PUBLICA por diseño —viaja al navegador— y por eso lleva el
# prefijo `NEXT_PUBLIC_`. La secreta no sale del servidor (D-035).
#
# Para probar el circuito sin cuenta, Cloudflare publica claves de prueba:
#   site   1x00000000000000000000AA              (siempre pasa, invisible)
#   secret 1x0000000000000000000000000000000AA   (siempre pasa)
#   secret 2x0000000000000000000000000000000AA   (siempre falla — para ver el 403)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Aviso de consumo (D-210). Sin esto, el aviso del 70% y el de presupuesto
# agotado quedan en `console.warn`, que en serverless no lo lee nadie.
# Sirve un webhook de Discord o de Slack: los dos son gratis y el cuerpo que se
# manda funciona con cualquiera de los dos.
# El mensaje son contadores agregados; NUNCA lleva una consulta.
ALERTA_WEBHOOK=

# O por correo, con Resend (D-212). Se eligio porque no pide dominio propio ni
# servidor SMTP y no agrega una dependencia: es un `fetch`. Su plan gratuito da
# 100 correos por dia contra los DOS que este aviso puede generar.
# ⚠ Con la clave gratuita y sin dominio verificado, Resend solo entrega al correo
# de la cuenta — que para avisarle al dueno alcanza.
# Van las dos o ninguna: con `ALERTA_EMAIL` y sin clave, se avisa por consola.
ALERTA_EMAIL=
RESEND_API_KEY=

# Límites de abuso. Los defaults salen de `04-costos-y-limites.md` y están en
# `src/lib/limites.ts`; estas variables sólo hacen falta para ajustarlos en
# despliegue o para probar el modo degradado sin agotar la cuota real.
#   LIMITE_IP_HORA=30
#   LIMITE_IP_DIA=60
#   LIMITE_TURNOS=20
#   LIMITE_GLOBAL_DIA=400
