# Gemini — Proyecto A, sin facturación habilitada (free tier intacto)
GEMINI_API_KEY_A=

# Gemini — Proyecto B, con facturación habilitada (desactivado por defecto)
GEMINI_API_KEY_B=

# Groq — fallback/overflow, free tier independiente
GROQ_API_KEY=

# Upstash Redis — rate limit y contador global (src/lib/limites.ts).
# Sin esto el limitador cuenta EN MEMORIA: exacto dentro de una instancia,
# ciego entre instancias. Funciona, pero en serverless el límite efectivo se
# multiplica por la cantidad de instancias. Ver D-123.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sal para hashear la IP en el rate limiter (D-034, R19). La IP cruda NUNCA se
# guarda. Sin esta variable se genera una sal efímera por instancia: más privado
# pero el límite diario por IP se reinicia con el proceso. En producción, fijarla.
#   openssl rand -hex 32
SAL_IP=

# Cloudflare Turnstile — anti-bot. Mientras esté vacía, la verificación no
# bloquea nada: el widget vive en el frontend y todavía no existe. Configurarla
# la activa sin tocar código.
TURNSTILE_SECRET_KEY=

# Límites de abuso. Los defaults salen de `04-costos-y-limites.md` y están en
# `src/lib/limites.ts`; estas variables sólo hacen falta para ajustarlos en
# despliegue o para probar el modo degradado sin agotar la cuota real.
#   LIMITE_IP_HORA=30
#   LIMITE_IP_DIA=60
#   LIMITE_TURNOS=20
#   LIMITE_GLOBAL_DIA=400
