.env
.env.*
!.env.example
docs/
node_modules/
.next/
pipeline/out/
*.log
.DS_Store

# Las dos fuentes de Project Gutenberg SI se commitean (D-024, R4): el parseo
# tiene que ser reproducible. Se excluye el resto de pipeline/raw/.
# Ojo: tiene que ser "raw/*" y no "raw/" — git no reabre un archivo si el
# directorio padre esta excluido, y el negado quedaria sin efecto en silencio.
pipeline/raw/*
!pipeline/raw/pg5000-images.html
!pipeline/raw/pg5000.txt
!pipeline/raw/checksums.json

# Experimento de separabilidad: el codigo y los resultados SI se publican
# (son la prueba de la tesis, D-036). Los datos pesados no.
experiments/*/data/
__pycache__/
*.pyc

# Node
/node_modules/
/.next/
# Las corridas del eval no se publican... salvo las DOS que respaldan el
# titular del README. Ver D-114.
#
# La tesis del proyecto es "no me creas, esta medido". Publicar el numero y
# esconder los datos que lo producen es pedir exactamente la confianza que el
# proyecto dice no necesitar — y ademas dejaba `evals:citas-corpus` sin nada
# contra que correr en un clon recien hecho.
#
# Con estas dos, un extrano reproduce el 96,9% -> 0% con un comando y sin claves.
evals/out/*
!evals/out/baseline-gemini.jsonl
!evals/out/rag-k3-gemini-voz8.jsonl

# Indices de experimento: se regeneran con `tools/indexar.ts --dtype q8`
artifacts/q8/

# Cache incremental de tsc/Next, se regenera sola
*.tsbuildinfo
